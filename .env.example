# Copy to .env locally; replace every placeholder before startup.
# Historical lab version, not a claim that this is the latest release.
STACK_VERSION=9.2.0
ES_BIND_ADDRESS=192.168.64.1
ES_PORT=9200
KIBANA_BIND_ADDRESS=127.0.0.1
KIBANA_PORT=5601
FLEET_BIND_ADDRESS=192.168.64.1
FLEET_PORT=8220
ES_JAVA_OPTS="-Xms2g -Xmx2g"
ELASTIC_PASSWORD=<ELASTIC_PASSWORD>
KIBANA_SYSTEM_PASSWORD=<KIBANA_SYSTEM_PASSWORD>
KIBANA_ENCRYPTED_SAVED_OBJECTS_KEY=<GENERATE_AT_LEAST_32_CHARACTERS>
KIBANA_SECURITY_ENCRYPTION_KEY=<GENERATE_AT_LEAST_32_CHARACTERS>
KIBANA_REPORTING_ENCRYPTION_KEY=<GENERATE_AT_LEAST_32_CHARACTERS>
# Fill these after Fleet setup; fleet-server is an optional Compose profile.
FLEET_SERVER_POLICY_ID=<FLEET_SERVER_POLICY_ID>
FLEET_SERVER_SERVICE_TOKEN=<FLEET_SERVER_SERVICE_TOKEN>
# DC01 enrollment uses a distinct token, entered locally, never committed.
ELASTIC_AGENT_ENROLLMENT_TOKEN=<ELASTIC_AGENT_ENROLLMENT_TOKEN>
